# development | production
APP_ENV=development

# PostgreSQL. Start it with `docker compose up -d database` from the repo root (password = POSTGRES_PASSWORD in ../.env)
DATABASE_URL=postgresql+psycopg://budget:change-me@localhost:5432/budget

# Change this in production (any long random string)
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Where the frontend runs (CORS + links in emails)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Optional SMTP for password-reset emails. When empty, the reset link is printed to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=budget@example.com

# Optional: enables real AI insights. Without it, rule-based insights are generated.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
